{
  "name": "future-radio-writers-room",
  "version": "0.1.0",
  "private": true,
  "description": "The Future Radio writers' room: Borges remembers, Leonardo creates, Agnolo keeps the score. Patrons watch the workshop.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "room": "tsx src/cli.ts",
    "seed": "tsx src/cli.ts seed",
    "verify": "tsx src/cli.ts verify",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "future-radio-character-bible": "github:leo-guinan/future-radio-character-bible",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
