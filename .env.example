# Leave empty to run the characters offline (deterministic, $0).
ANTHROPIC_API_KEY=
ROOM_MODEL=claude-sonnet-5-5
# Set both to turn token usage into observed USD cost on Agnolo's ledger.
# Leave empty and compute is recorded as "unknown" — never as free.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# Producer API (explore, move ideas, signals, advance episodes). Long random string.
PRODUCER_TOKEN=
PRODUCER_NAME=leo

# Patron limits
PATRON_DAILY_RUNS=40
PATRON_RUNS_PER_IP=5
IDEAS_PER_IP=5
DEFAULT_CASH_CEILING=20
PORT=8787
