# Leave empty to run the characters offline (deterministic, $0).
ANTHROPIC_API_KEY=
ROOM_MODEL=claude-sonnet-5-5
# Set both to turn token usage into observed USD cost on Agnolo's ledger.
# Leave empty and compute is recorded as "unknown" — never as free.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# Producer API (explore, move ideas, signals, advance episodes). Long random string.
PRODUCER_TOKEN=
PRODUCER_NAME=leo

# Patron limits
PATRON_DAILY_RUNS=40
PATRON_RUNS_PER_IP=5
IDEAS_PER_IP=5
DEFAULT_CASH_CEILING=20
PORT=8787

# Showrunner
SHOWRUNNER_AUTO=1                 # run rounds when ideas arrive (0 = only on command)
SHOWRUNNER_EVERY_SECONDS=300      # also make rounds on a timer (0 = off)
SHOWRUNNER_DAILY_EXPLORES=30      # cap on ideas the showrunner sends to the room per day
INTAKE_EPISODE=E02                # where unassigned ideas are considered
REPOS_DIR=                        # defaults to ./repos (Docker: /data/repos)
ROOM_GIT_NAME=Future Radio Room
ROOM_GIT_EMAIL=room@future.radio
REPO_PREFIX=future-radio-

# Character bibles and viewer pull requests
GITHUB_OWNER=leo-guinan           # where the repos live
SYNC_EVERY_SECONDS=600            # pull merged viewer PRs into dressing rooms (only once they have a GitHub remote)
CHARACTER_MODEL=claude-sonnet-5-5 # used by `bible chat`

# Scenes are text; these switch on hearing a line (generated once, cached, on the ledger).
ELEVENLABS_API_KEY=
# TTS_MODEL=eleven_v4
# TTS_PRICE_PER_1K_CHARS=
# VOICE_PATRON_DAILY=30
# VOICE_PER_IP=10
